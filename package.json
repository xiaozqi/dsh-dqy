{
  "name": "dsh-dqy",
  "version": "0.3.0",
  "description": "DQY - autonomous Android agent plugin for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "resources",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/smoke.mjs tests/safety.mjs",
    "test:smoke": "npm run build && node --test tests/smoke.mjs tests/safety.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "android",
    "agent",
    "automation",
    "adb"
  ],
  "author": "xiaozqi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaozqi/dsh-dqy.git"
  },
  "homepage": "https://github.com/xiaozqi/dsh-dqy#readme",
  "bugs": {
    "url": "https://github.com/xiaozqi/dsh-dqy/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  }
}
