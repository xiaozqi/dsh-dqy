# Dependencies and build output
node_modules/
# lib/ is committed on purpose: DSH installs this package straight from git,
# and the host does not run a build step for git dependencies.
*.log

# Local runtime data (secrets, memory, screenshots, one-off scripts)
data/

# Vendored binaries and local python virtual environments
vendor/

# Packed release artifacts
*.tgz

# OS files
.DS_Store

# Android notify-listen: machine-local SDK config and Gradle build output
android/notify-listen/.gradle/
android/notify-listen/app/build/
android/notify-listen/local.properties

# Large offline voice model; download separately (see README)
resources/voice-models/vosk-small-cn.zip
